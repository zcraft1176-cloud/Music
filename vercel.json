{
    "buildCommand": "node scripts/fetch-ytdlp.js && npm run build:css",
    "outputDirectory": ".",
    "functions": {
        "api/proxy.js": {
            "maxDuration": 30
        },
        "api/ytsearch.js": {
            "includeFiles": "bin/**",
            "maxDuration": 30
        },
        "api/download.js": {
            "maxDuration": 60
        },
        "api/cobalt.js": {
            "maxDuration": 30
        },
        "api/spotify.js": {
            "maxDuration": 30
        }
    },
    "rewrites": [
        { "source": "/api/proxy", "destination": "/api/proxy" },
        { "source": "/api/download", "destination": "/api/download" },
        { "source": "/api/cobalt", "destination": "/api/cobalt" },
        { "source": "/api/spotify", "destination": "/api/spotify" }
    ]
}
